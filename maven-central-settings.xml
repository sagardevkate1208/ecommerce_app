<?xml version="1.0" encoding="UTF-8"?>
<!-- Use with: mvnw -s ../maven-central-settings.xml ...
     Bypasses any corporate mirror configured in ~/.m2/settings.xml. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <mirrors>
        <mirror>
            <id>maven-central</id>
            <mirrorOf>*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
